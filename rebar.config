%% Add debug information in compiled code for other tools like debuggers, code coverage tools, or analysis tools
{erl_opts, [debug_info]}

.

{deps,
 % worker pool library
 [poolboy]}

.

%% Defensive xref configuration
{xref_checks,
 [undefined_function_calls,
  locals_not_used,
  deprecated_function_calls]}

.

%% Code formatter
{project_plugins, [rebar3_format, rebar3_proper]}

.

%% katana_code (a rebar3_format dependency) is pinned to ~> 2.0.2, which
%% still uses the bare `catch ... of` syntax deprecated in OTP 29. Its
%% own rebar.config sets warnings_as_errors, turning that deprecation
%% warning into a build failure. Strip warnings_as_errors when building
%% that dependency so the (unrelated) deprecation warning doesn't block
%% the build.
{overrides,
 [{override, katana_code, [{erl_opts, [debug_info]}]}]}

.

{format, [{formatter, otp_formatter}]}

.

%%-------------------------------------------------------------------
%% Profiles
%%-------------------------------------------------------------------

{profiles,
 [{test,
   [{extra_src_dirs, [{"test", [{recursive, true}]}]},
    {erl_opts, [nowarn_export_all]},
    {plugins, [coveralls]},
    {deps, [meck]}]},
  {proper,
   [{extra_src_dirs, [{"test", [{recursive, true}]}]},
    {erl_opts,
     [nowarn_export_all, {d, 'PROPER'}, {d, 'TEST'}]},
    {plugins, [coveralls]},
    {deps, [meck, {proper, "1.4.0"}, recon]}]},
  {docs, [{deps, [{edown, "0.7.0"}]}]}]}

.

{cover_enabled, true}

.

{cover_export_enabled, true}

.

{coveralls_coverdata, "_build/test/cover/*.coverdata"}

.

{coveralls_service_name, "github"}

.
